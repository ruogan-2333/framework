{
  "blocks": [
    {
      "id": "social_app.app_type",
      "module": "social_app",
      "topic": "Social app type, dating, and nudity focus",
      "block_show_if": [
        {
          "id": "exec_social_app_type_visible",
          "option_id": "yes"
        }
      ],
      "questions": {
        "app_type": {
          "category": "mutual",
          "question": "Which of the following would best describe the app? (Communication: one-on-one or small group conversations with known people, e.g. Skype, SMS, Gmail; Social: communicate/post/share with large groups or meet new people, e.g. Facebook, Twitter, Instagram, Tinder.)",
          "type": "single",
          "options": [
            {
              "id": "communication_used_to_communicate_with_people_al",
              "value": "Communication - used to communicate with people already known to the user in one-on-one or small group conversations. Skype, SMS, and Gmail are examples of these types of products."
            },
            {
              "id": "social_used_to_communicate_post_and_share_conten",
              "value": "Social - used to communicate, post, and share content with large groups of people or for meeting new people. Facebook, Twitter, Instagram, Tinder are examples of these types of products."
            }
          ],
          "show_if": null
        },
        "dating_or_sex": {
          "category": "severity",
          "question": "Is a significant portion of the app used to connect people for the purposes of dating or sexual relationships or endeavors?",
          "type": "single",
          "options": [
            {
              "id": "yes",
              "value": "Yes",
              "weight": 1
            },
            {
              "id": "no",
              "value": "No",
              "weight": 0
            }
          ],
          "show_if": {
            "id": "app_type",
            "option_id": "social_used_to_communicate_post_and_share_conten"
          }
        },
        "nudity": {
          "category": "severity",
          "question": "In this screenshot, is there any visible public sharing or depiction of nudity?",
          "type": "single",
          "options": [
            {
              "id": "yes",
              "value": "Yes",
              "weight": 1
            },
            {
              "id": "no",
              "value": "No",
              "weight": 0
            }
          ],
          "show_if": {
            "id": "app_type",
            "option_id": "social_used_to_communicate_post_and_share_conten"
          }
        },
        "primary_focus": {
          "category": "severity",
          "question": "Is public sharing or depiction of nudity the primary focus of the app?",
          "type": "single",
          "options": [
            {
              "id": "yes",
              "value": "Yes",
              "weight": 1
            },
            {
              "id": "no",
              "value": "No",
              "weight": 0
            }
          ],
          "show_if": {
            "id": "nudity",
            "option_id": "yes"
          }
        }
      }
    },
